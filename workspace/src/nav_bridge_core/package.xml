<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_bridge_core</name>
  <version>0.1.0</version>
  <description>
    Sample navigation-bridge core package used as a realistic CI target for
    the ROS2 CI &amp; Build-Health Bridge portfolio sample. Not a production
    navigation stack.
  </description>
  <maintainer email="jigondaniel1224@gmail.com">Jigon Yoo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
